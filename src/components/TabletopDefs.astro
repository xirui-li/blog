---
// Shared SVG pieces for the tabletop figures: table, basket, cups, gripper.
// Drawn in viewBox units; cups and gripper are positioned by script.
---

<style is:global>
  .tt svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--sans);
  }

  .tt-table {
    fill: #e9e9e4;
  }

  .tt-basket {
    fill: #f3e4cc;
    stroke: #c9a978;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .tt-weave {
    fill: none;
    stroke: #c9a978;
    stroke-width: 1.5;
  }

  .tt-cup-red path,
  .tt-cup-red ellipse {
    fill: #e6866f;
    stroke: #b9553e;
    stroke-width: 1.5;
  }

  .tt-cup-blue path,
  .tt-cup-blue ellipse {
    fill: #80b3e3;
    stroke: #4f86bd;
    stroke-width: 1.5;
  }

  .tt-gripper rect,
  .tt-gripper line {
    fill: #f2f2f0;
    stroke: #8c8f94;
    stroke-width: 1.5;
  }

  .tt-label {
    font-size: 12px;
    fill: var(--muted);
  }

  /* Controls under a tabletop figure */
  .tt-controls {
    display: grid;
    gap: 10px;
    margin-top: 10px;
  }

  .tt-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  .tt-row-label {
    font-size: 11px;
    letter-spacing: 0.72px;
    text-transform: uppercase;
    color: var(--muted);
    min-width: 64px;
  }

  .tt-seg {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: #fff;
  }

  .tt-seg button {
    font: 12px/1.4 var(--sans);
    padding: 6px 11px;
    border: 0;
    border-radius: 3px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  .tt-seg button[aria-pressed='true'] {
    background: #f1f2ee;
    color: var(--ink);
  }

  .tt-status {
    min-height: 1.6em;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink);
  }

  .tt-chip {
    display: inline-block;
    margin-right: 8px;
    padding: 1px 8px;
    border-radius: 999px;
    background: #fde4cd;
    font-size: 11px;
    color: #1f1f1f;
  }
</style>
