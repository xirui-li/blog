---
// Box-and-arrow diagrams in the style of Meta research paper figures.
// Coordinates are in viewBox units; the SVG scales to the figure width.
// Wrap in <Figure title="…" caption="…"> for a numbered caption.
// `animate` sends a token along the edges in `step` order and pulses each
// node as the token arrives (SVG animation, off under reduced motion).
import {
  PALETTE,
  nodeBox,
  routeEdge,
  tokenRects,
  trapezoidPoints,
  type DiagramEdge,
  type DiagramGroup,
  type DiagramNode,
  type LegendItem,
} from '../lib/diagram';
import { withBase } from '../lib/posts';

interface Props {
  width: number;
  height: number;
  nodes: DiagramNode[];
  edges?: DiagramEdge[];
  groups?: DiagramGroup[];
  legend?: { x: number; y: number; items: LegendItem[]; direction?: 'row' | 'column' };
  /** Accessible description of the diagram. */
  label?: string;
  /** Animate the workflow: tokens flow along edges in `step` order. */
  animate?: boolean;
  /** Run the steps from..to (inclusive) this many times per cycle, e.g. a loop that iterates while setup steps run once. */
  repeat?: { from: number; to: number; times: number };
}

const { width, height, nodes, edges = [], groups = [], legend, label, animate = false, repeat } = Astro.props;
const byId = new Map(nodes.filter((n) => n.id).map((n) => [n.id!, n]));
const routed = edges.map((e) => routeEdge(e, byId));

// Animation schedule: tokens move at a constant SPEED (viewBox units per
// second). Edges sharing a step leave together; the next step starts when the
// longest of them arrives. Steps inside `repeat` run several times. The cycle
// ends with a short pause.
const SPEED = 140;
const PULSE = 0.7;
const uid = Math.random().toString(36).slice(2, 8);
const steps = edges.map((e, i) => e.step ?? i);
const moving = edges.map((e) => !e.still);
const order = [...new Set(steps.filter((_, i) => moving[i]))].sort((p, q) => p - q);
const inRepeat = (s: number) => !!repeat && s >= repeat.from && s <= repeat.to;
const timeline = [
  ...order.filter((s) => !!repeat && s < repeat.from),
  ...Array.from({ length: repeat?.times ?? 1 }, () => order.filter((s) => (repeat ? inRepeat(s) : true))).flat(),
  ...order.filter((s) => !!repeat && s > repeat.to),
];
const runs: [number, number][][] = edges.map(() => []);
let clock = 0;
for (const s of timeline) {
  const members = edges.flatMap((_, i) => (moving[i] && steps[i] === s ? [i] : []));
  for (const i of members) runs[i].push([clock, clock + routed[i].length / SPEED]);
  clock += Math.max(...members.map((i) => routed[i].length)) / SPEED;
}
const cycle = +(clock + 1.4).toFixed(2);
const frac = (t: number) => +Math.min(1, Math.max(0, t / cycle)).toFixed(4);
// Per edge: when its token is visible and where along the path it is.
const tokens = animate
  ? edges.map((e, i) => {
      if (!moving[i]) return undefined;
      const from = typeof e.from === 'string' ? byId.get(e.from) : undefined;
      const r = runs[i].map(([a, b]) => [frac(a), frac(b)] as const);
      return {
        path: `${uid}-e${i}`,
        runs: r,
        motion: {
          keyTimes: [0, ...r.flatMap(([a, b]) => [a, b, b]), 1].join(';'),
          keyPoints: [0, ...r.flatMap(() => [0, 1, 0]), 0].join(';'),
        },
        fade: {
          keyTimes: [0, ...r.flatMap(([a, b]) => [a, a, b, b]), 1].join(';'),
          values: [0, ...r.flatMap(() => [0, 1, 1, 0]), 0].join(';'),
        },
        color: from ? PALETTE[from.kind ?? 'model'].stroke : '#8a96a3',
      };
    })
  : [];
// Nodes pulse when a token arrives; source-only nodes pulse when one leaves.
const pulses = animate
  ? nodes
      .filter((n) => n.id && n.shape !== 'text' && n.shape !== 'tokens')
      .flatMap((n) => {
        const arrive = edges.flatMap((e, i) => (e.to === n.id && tokens[i] ? tokens[i]!.runs.map(([, b]) => b) : []));
        const leave = edges.flatMap((e, i) => (e.from === n.id && tokens[i] ? tokens[i]!.runs.slice(0, 1).map(([a]) => a) : []));
        const times = arrive.length ? arrive : leave.slice(0, 1);
        return times.map((t) => ({ n, keyTimes: [0, t, Math.min(1, t + frac(PULSE) * 0.3), Math.min(1, t + frac(PULSE)), 1] }));
      })
  : [];

const lines = (s = '') => s.split('\n');
const LINE = 1.25; // line height in em

// Column legends stack items; row legends advance by an estimated label width.
let cursor = 0;
const legendItems = (legend?.items ?? []).map((item) => {
  const row = legend!.direction === 'row';
  const pos = { x: legend!.x + (row ? cursor : 0), y: legend!.y + (row ? 0 : cursor) };
  cursor += row ? 30 + item.label.length * 8 + 28 : 30;
  return { ...item, ...pos };
});
---

<svg
  class="diagram"
  viewBox={`0 0 ${width} ${height}`}
  style={`max-width: ${width}px`}
  role="img"
  aria-label={label}
  xmlns="http://www.w3.org/2000/svg"
>
  {
    groups.map((g) => (
      <g class="group">
        {Array.from({ length: g.stack ?? 0 }, (_, k) => g.stack! - k).map((k) => (
          <rect
            x={g.x + k * 9}
            y={g.y - k * 9}
            width={g.w}
            height={g.h}
            rx={18}
            class="group-stack"
            opacity={1 - (k - 1) * 0.35}
          />
        ))}
        <rect
          x={g.x}
          y={g.y}
          width={g.w}
          height={g.h}
          rx={g.variant === 'filled' ? 14 : 18}
          class:list={[g.variant === 'filled' ? 'group-filled' : 'group-dashed', { 'group-front': g.stack }]}
        />
        {g.label && g.labelPos === 'bracket' && (
          <text x={g.x + 24} y={g.y + g.h - 16} class="group-bracket">
            [ {g.label} ]
          </text>
        )}
        {g.label && g.labelPos !== 'bracket' && (
          <text x={g.x + g.w / 2} y={g.y - 14} text-anchor="middle" class="group-top">
            {g.label}
          </text>
        )}
      </g>
    ))
  }

  {
    routed.map((r) => (
      <g class="edge">
        <path d={r.d} id={animate ? `${uid}-e${routed.indexOf(r)}` : undefined} class:list={['edge-line', { dashed: r.dashed }]} />
        {r.arrow && <path d={r.arrow} class="edge-line" />}
        {r.label && (
          <text x={r.label.x} y={r.label.y} text-anchor="middle" dominant-baseline="central" class="edge-label">
            {r.label.text}
          </text>
        )}
      </g>
    ))
  }

  {
    nodes.map((n) => {
      const b = nodeBox(n);
      const c = PALETTE[n.kind ?? (n.shape === 'tokens' ? 'plain' : 'model')];
      const size = n.size ?? (n.kind === 'tag' || n.kind === 'dark' || n.kind === 'go' ? 14 : 16);
      const ls = lines(n.label);
      const textAttrs = {
        'font-size': size,
        'font-weight': n.weight ?? (n.shape === 'text' ? 400 : 450),
        'font-style': n.italic ? 'italic' : undefined,
        fill: n.color ?? (n.shape === 'text' ? '#1f1f1f' : c.text),
      };
      const label = (cx: number, cy: number, anchor = 'middle') => (
        <text x={cx} y={cy} text-anchor={anchor} dominant-baseline="central" {...textAttrs}>
          {ls.map((line, i) => (
            <tspan x={cx} dy={i === 0 ? `${(-(ls.length - 1) * LINE) / 2}em` : `${LINE}em`}>
              {line}
            </tspan>
          ))}
        </text>
      );

      if (n.shape === 'text') return label(n.x, n.y, n.align ?? 'start');
      if (n.shape === 'image')
        return (
          <image href={n.src && withBase(n.src)} x={b.x} y={b.y} width={b.w} height={b.h} preserveAspectRatio="xMidYMid meet" />
        );
      if (n.shape === 'tokens')
        return (
          <g>
            {tokenRects(n).map((t) => (
              <rect x={t.x} y={t.y} width={t.w} height={t.h} rx={5} fill={n.kind ? c.fill : '#e6e6e6'} stroke={n.kind ? c.stroke : '#9b9b9b'} stroke-width="1.5" />
            ))}
          </g>
        );
      return (
        <g class="node">
          {n.shape === 'trapezoid' ? (
            <polygon points={trapezoidPoints(n)} fill={c.fill} stroke={c.stroke} stroke-width="2.5" stroke-linejoin="round" />
          ) : (
            <rect
              x={b.x}
              y={b.y}
              width={b.w}
              height={b.h}
              rx={n.shape === 'pill' ? b.h / 2 : 9}
              fill={c.fill}
              stroke={c.stroke}
              stroke-width="2.5"
            />
          )}
          {n.label && label(b.x + b.w / 2, b.y + b.h / 2)}
        </g>
      );
    })
  }

  {
    animate && (
      <g class="flow" aria-hidden="true">
        {pulses.map(({ n, keyTimes }) => {
          const b = nodeBox(n);
          const stroke = PALETTE[n.kind ?? 'model'].stroke;
          const color = stroke === 'none' ? PALETTE[n.kind ?? 'model'].fill : stroke;
          const anim = <animate attributeName="opacity" values="0;0;0.55;0;0" keyTimes={keyTimes.join(';')} dur={`${cycle}s`} repeatCount="indefinite" />;
          return n.shape === 'trapezoid' ? (
            <polygon points={trapezoidPoints(n)} fill="none" stroke={color} stroke-width="8" stroke-linejoin="round" opacity="0">{anim}</polygon>
          ) : (
            <rect x={b.x} y={b.y} width={b.w} height={b.h} rx={n.shape === 'pill' ? b.h / 2 : 9} fill="none" stroke={color} stroke-width="8" opacity="0">
              {anim}
            </rect>
          );
        })}
        {tokens.filter((t) => t !== undefined).map((t) => (
          <circle r="6" fill={t.color} stroke="#fff" stroke-width="2" opacity="0">
            <animateMotion dur={`${cycle}s`} repeatCount="indefinite" calcMode="linear" keyPoints={t.motion.keyPoints} keyTimes={t.motion.keyTimes}>
              <mpath href={`#${t.path}`} />
            </animateMotion>
            <animate attributeName="opacity" values={t.fade.values} keyTimes={t.fade.keyTimes} dur={`${cycle}s`} repeatCount="indefinite" />
          </circle>
        ))}
      </g>
    )
  }

  {
    legendItems.map((item) => (
      <g class="legend">
        {item.kind === 'group' ? (
          <rect x={item.x} y={item.y} width="20" height="20" rx="4" class="group-dashed" />
        ) : (
          <rect x={item.x} y={item.y} width="20" height="20" rx="4" fill={PALETTE[item.kind].fill} stroke={PALETTE[item.kind].stroke} stroke-width="2" />
        )}
        <text x={item.x + 30} y={item.y + 10} dominant-baseline="central" class="legend-label">
          {item.label}
        </text>
      </g>
    ))
  }
</svg>

<style>
  /* Never scaled up: at most 1:1 with its viewBox, centered. */
  .diagram {
    display: block;
    margin-inline: auto;
    width: 100%;
    height: auto;
    font-family: var(--sans);
    font-feature-settings: 'ss01', 'cv11';
  }

  .edge-line {
    fill: none;
    stroke: #9ea8b3;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .edge-line.dashed {
    stroke-dasharray: 6 6;
  }

  /* White halo breaks the line behind the label, as in the paper figures. */
  .edge-label {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    fill: #1f1f1f;
    stroke: #fff;
    stroke-width: 10px;
    stroke-linejoin: round;
    paint-order: stroke;
  }

  .group-dashed {
    fill: none;
    stroke: #b4b8be;
    stroke-width: 2;
    stroke-dasharray: 5 5;
  }

  /* Faded copies behind a stacked group; the front copy hides their insides. */
  .group-stack {
    fill: #f6f6fa;
    stroke: #c9c7e0;
    stroke-width: 1.5;
    stroke-dasharray: 5 5;
  }

  .group-front {
    fill: #fff;
  }

  .group-filled {
    fill: #f2f2f2;
  }

  .group-top {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    fill: #1f1f1f;
  }

  .group-bracket {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    fill: #1f1f1f;
  }

  @media (prefers-reduced-motion: reduce) {
    .flow {
      display: none;
    }
  }

  .legend-label {
    font-size: 15px;
    fill: #1f1f1f;
  }
</style>
