---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate, withBase } from '../lib/posts';
import { SITE } from '../site.config';

const posts = await getPosts();
---

<Base title={SITE.name}>
  <section class="intro">
    <p class="eyebrow">{SITE.author}</p>
    <h1>{SITE.name}</h1>
    <p>{SITE.description}</p>
  </section>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <article>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <h2>
              <a href={withBase(`posts/${post.id}/`)}>{post.data.title}</a>
              {post.data.draft && <span class="draft-badge">Draft</span>}
            </h2>
            <p>{post.data.description}</p>
            <a class="read-link" href={withBase(`posts/${post.id}/`)}>Read post →</a>
          </article>
        </li>
      ))
    }
  </ul>
</Base>
