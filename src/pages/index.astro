---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate, withBase } from '../lib/posts';
import { SITE } from '../site.config';

const posts = await getPosts();
---

<Base title={SITE.name}>
  <Fragment slot="aside">
    <p class="eyebrow">{SITE.author}</p>
    <p class="side-title">{SITE.name}</p>
    <p class="side-text">{SITE.description}</p>
    <a class="side-button" href={SITE.homepage}>Homepage</a>
  </Fragment>

  <!-- On wide screens the intro lives in the side panel. -->
  <section class="intro narrow-only">
    <p class="eyebrow">{SITE.author}</p>
    <h1>{SITE.name}</h1>
    <p>{SITE.description}</p>
  </section>

  <p class="list-heading wide-only">All posts</p>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <article>
            <p class="post-date">Date: <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
            <h2>
              <a href={withBase(`posts/${post.id}/`)}>{post.data.title}</a>
              {post.data.draft && <span class="draft-badge">Draft</span>}
            </h2>
            <p>{post.data.description}</p>
            <a class="read-link" href={withBase(`posts/${post.id}/`)}>Read post →</a>
          </article>
        </li>
      ))
    }
  </ul>
</Base>
